<Project Sdk="Dalamud.NET.Sdk/14.0.1">

	<!-- Compiler Settings -->
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Platforms>x64</Platforms>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<NoWarn>1701;1702</NoWarn>
	</PropertyGroup>

	<!-- Project Information -->
	<PropertyGroup>
		<Version>2.0.0.0</Version>
		<Authors>PunishedPineapple</Authors>
		<Product />
		<Copyright>Copyright © PunishedPineapple 2022-2026</Copyright>
		<RepositoryUrl>https://github.com/PunishedPineapple/WhatDidYouSay</RepositoryUrl>
		<PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
	</PropertyGroup>

	<!-- Dalamud Plugin Manifest -->
	<PropertyGroup>
		<Author>$(Authors)</Author>
		<Name>Say What?</Name>
		<Punchline>Persistent NPC Flavor Text</Punchline>
		<Description>Prints NPC speech bubbles to the chat log.  Please check the plugin settings and your chat log filters to make sure that they are compatible with each other.</Description>
		<RepoUrl>$(RepositoryUrl)</RepoUrl>
		<IconUrl>$(RepositoryUrl)/raw/main/docs/Images/icon.png</IconUrl>
		<ImageUrls>$(RepositoryUrl)/raw/main/docs/Images/image1.png;$(RepositoryUrl)/raw/main/docs/Images/image2.png</ImageUrls>
		<Tags>Chat;NPC;Bubble;Balloon</Tags>
	</PropertyGroup>

	<!-- Dependencies -->
	<ItemGroup>
		<Reference Include="CheapLoc">
			<Private>false</Private>
			<HintPath>$(DalamudLibPath)CheapLoc.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!-- Bundled Resource Files -->
	<ItemGroup>
		<Content Include="Resources\**" DestinationFolder="Resources\$(RecursiveDir)" CopyToOutputDirectory="Always" />
	</ItemGroup>

	<!-- Dalamud Plugin Packaging -->
	<ItemGroup>
		<None Include="DalamudPackager.targets" />
	</ItemGroup>

	<!-- Other files -->
	<ItemGroup>
		<Content Include="Docs\**" />
	</ItemGroup>

</Project>